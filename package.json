    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.7",
    "eslint": "^9.39.5",
